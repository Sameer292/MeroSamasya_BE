DATABASE_URL=sqlite+aiosqlite:///./merosamasya.db
# Remember to use "+aiosqlite" if using local sqlite db and "+asyncpg" if using supabase postgres

JWT_SECRET=your_strong_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=15

# Optional. Issue photos and avatars use local storage when Cloudinary is unset.
# KYC documents always use private local storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_STORAGE_DIR=./storage

# Use the browser-facing Next.js origin. Set cookie security to false only for local HTTP.
ADMIN_WEB_ORIGIN=http://localhost:3000
ADMIN_COOKIE_SECURE=true
